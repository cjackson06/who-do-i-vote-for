# Legacy backend (until Phase 3 cutover)
GOOGLE_API_KEY=

# Django — read by pydantic-settings from this file
# (see backend/config/settings/base.py; field name == env var name)
# SECRET_KEY=            # required in production; dev fallback otherwise
# ALLOWED_HOSTS=         # comma-separated, e.g. example.com,www.example.com (required in production)
# DATABASE_URL=          # defaults to local sqlite; hosted uses postgres://user:pass@host:5432/db
# SECURE_SSL_REDIRECT=   # prod hardening toggle; compose defaults false for local runs

# Phase 1 — model roles (apps/llm; OpenAI-compatible endpoints)
# Global fallbacks: every role uses these unless overridden per role below
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TEMPERATURE=

# Per-role overrides: LLM_<ROLE>_BASE_URL / _API_KEY / _MODEL / _TEMPERATURE
# Roles: profiler, researcher, summarizer, matcher, recommender, judge
# LLM_RESEARCHER_BASE_URL=
# LLM_RESEARCHER_API_KEY=
# LLM_RESEARCHER_MODEL=
# LLM_RESEARCHER_TEMPERATURE=

# Phase 2+ — research sources
# TAVILY_API_KEY=
